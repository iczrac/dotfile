{
  "title": "enhance tmux with prefix \\ with other keys",
  "rules": [
    {
      "description": "tmux enhance",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "quote"
          },
          "to": [
            {
              "set_variable": {
                "name": "tmux_mode",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "tmux_mode",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "quote"
            }
          ]
        },
        {
          "description": "break pane to new window (cmd+c)",
          "type": "basic",
          "conditions": [
            {
              "name": "tmux_mode",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "e",
              "modifiers": [
                "left_control"
              ]
            },
            {
              "key_code": "b",
              "modifiers": [
                "left_shift"
              ]
            }
          ]
        },
        {
          "description": "new window",
          "type": "basic",
          "conditions": [
            {
